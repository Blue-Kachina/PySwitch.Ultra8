{
  "functions": {

    "REC_PLY": {
      "description": "Record / Play / Overdub toggle — the primary lane control button.",
      "states": {
        "recording":   { "color": "RED",           "brightness": 0.3,  "label": "PLY"  },
        "overdubbing": { "color": "RED",           "brightness": 0.3,  "label": "PLY"  },
        "playing":     { "color": "TURQUOISE",     "brightness": 0.3,  "label": "REC" },
        "stopped":     { "color": "DARK_GRAY",     "brightness": 0.15, "label": "REC"  },
        "empty":       { "color": "BLACK",         "brightness": 0.02, "label": "REC"  },
        "waiting":     { "color": "DARK_GRAY",     "brightness": 0.02, "label": null   },
        "error":       { "color": "PURPLE",        "brightness": 0.3,  "label": null   }
      }
    },

    "PLY_STP": {
      "description": "Play / Stop toggle.",
      "states": {
        "recording":   { "color": "RED",           "brightness": 0.3,  "label": "STP"  },
        "overdubbing": { "color": "RED",           "brightness": 0.3,  "label": "STP"  },
        "playing":     { "color": "TURQUOISE",     "brightness": 0.3,  "label": "STP"  },
        "stopped":     { "color": "DARK_GRAY",     "brightness": 0.15, "label": "PLY"  },
        "empty":       { "color": "BLACK",         "brightness": 0.02, "label": null  },
        "waiting":     { "color": "DARK_GRAY",     "brightness": 0.02, "label": null   },
        "error":       { "color": "PURPLE",        "brightness": 0.3,  "label": null   }
      }
    },

    "CLR": {
      "description": "Clear lane. Lit when there is audio content to clear.",
      "states": {
        "has_audio":   { "color": "PURPLE",        "brightness": 0.3,  "label": "CLR"  },
        "empty":       { "color": "DARK_PURPLE",   "brightness": 0.1,  "label": null  },
        "waiting":     { "color": "DARK_GRAY",     "brightness": 0.02, "label": null   }
      }
    },

    "MON": {
      "description": "Monitor / speaker toggle.",
      "states": {
        "active":      { "color": "BLUE",          "brightness": 0.3,  "label": "MON"  },
        "inactive":    { "color": "DARK_BLUE",     "brightness": 0.1,  "label": "MON"  },
        "waiting":     { "color": "DARK_GRAY",     "brightness": 0.02, "label": null   }
      }
    },

    "UNDO": {
      "description": "Undo / Redo toggle. State reflects what the next press will do.",
      "states": {
        "available":       { "color": "DARK_YELLOW",      "brightness": 0.3,  "label": "UNDO" },
        "redo_available":  { "color": "DARK_ORANGE",      "brightness": 0.3,  "label": "REDO" },
        "unavailable":     { "color": "DARK_GRAY",        "brightness": 0.02,  "label": null },
        "waiting":         { "color": "DARK_GRAY",        "brightness": 0.02, "label": null   }
      }
    },

    "REDO": {
      "description": "Redo (future — not yet in Ultra8 protocol). Lit when redo stack is non-empty.",
      "states": {
        "available":   { "color": "YELLOW",        "brightness": 0.3,  "label": "REDO" },
        "unavailable": { "color": "DARK_YELLOW",   "brightness": 0.1,  "label": "REDO" },
        "waiting":     { "color": "DARK_GRAY",     "brightness": 0.02, "label": null   }
      }
    }

  }
}
